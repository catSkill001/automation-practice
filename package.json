{
  "name": "playwright-practice-suite",
  "version": "1.0.0",
  "description": "Suite de práctica con 53 tests de Playwright organizados por categoría",
  "main": "index.js",
  "scripts": {
    "setup": "npm install && npx playwright install --with-deps",
    "setup:fast": "npm install && npx playwright install",
    "test": "playwright test",
    "test:dev": "cross-env ENVIRONMENT=dev playwright test",
    "test:qa": "cross-env ENVIRONMENT=qa playwright test",
    "test:stage": "cross-env ENVIRONMENT=stage playwright test",
    "test:prod": "cross-env ENVIRONMENT=prod playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:locators": "playwright test locators --headed",
    "test:tables": "playwright test tables --headed",
    "test:interactions": "playwright test interactions --headed",
    "test:files": "playwright test files --headed",
    "test:api": "playwright test api",
    "test:visual": "playwright test visual",
    "test:accessibility": "playwright test accessibility",
    "test:pom": "playwright test pom --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@playwright/test": "^1.58.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.1.0",
    "cross-env": "^10.1.0"
  }
}
