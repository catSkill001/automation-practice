# Variables de Entorno - Plantilla
# Copia este archivo a .env y completa con tus valores reales

# ============================================
# CONFIGURACIÓN DE ENTORNO
# ============================================
# Selecciona el entorno: dev, qa, stage, prod
ENVIRONMENT=dev

# ============================================
# URLs POR ENTORNO (opcional)
# Si no defines estas, se usará la URL por defecto
# ============================================
# DEV_BASE_URL=https://dev.testautomationpractice.blogspot.com
# QA_BASE_URL=https://qa.testautomationpractice.blogspot.com
# STAGE_BASE_URL=https://stage.testautomationpractice.blogspot.com
# PROD_BASE_URL=https://testautomationpractice.blogspot.com

# ============================================
# URL DIRECTA (opcional)
# Si defines BASE_URL, se usará esta en lugar de la del entorno
# ============================================
# BASE_URL=https://custom-url.com

# ============================================
# OTROS SECRETOS
# ============================================
# Git Token (opcional, para operaciones que requieran autenticación)
# GITHUB_TOKEN=tu_token_aqui

# Variables de CI/CD
# CI=false
